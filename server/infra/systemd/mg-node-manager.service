[Unit]
Description=Middleground Node Manager
After=network.target docker.service

[Service]
Type=simple
User=root
WorkingDirectory=/home/middleground/.worktrees/control-plane-ragflow-v1
EnvironmentFile=/home/middleground/.secrets/node-manager.env
ExecStart=/usr/local/bin/node node_modules/tsx/dist/cli.mjs apps/node-manager/src/main.ts
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
