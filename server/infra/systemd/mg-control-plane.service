[Unit]
Description=Middleground Control Plane
After=network.target docker.service

[Service]
Type=simple
User=root
WorkingDirectory=/home/middleground/.worktrees/control-plane-ragflow-v1
EnvironmentFile=/home/middleground/.secrets/control-plane.env
ExecStart=/usr/local/bin/node node_modules/tsx/dist/cli.mjs apps/control-plane/src/main.ts
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
