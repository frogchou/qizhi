{
  "anyOf": [
    {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "protocolVersion",
        "taskId",
        "taskNodeId",
        "instanceId",
        "status",
        "output",
        "evidence",
        "risks",
        "artifacts"
      ],
      "properties": {
        "protocolVersion": {
          "const": "v1",
          "type": "string"
        },
        "taskId": {
          "minLength": 1,
          "maxLength": 160,
          "type": "string"
        },
        "taskNodeId": {
          "minLength": 1,
          "maxLength": 160,
          "type": "string"
        },
        "instanceId": {
          "minLength": 1,
          "maxLength": 160,
          "type": "string"
        },
        "status": {
          "anyOf": [
            {
              "const": "succeeded",
              "type": "string"
            },
            {
              "const": "failed",
              "type": "string"
            }
          ]
        },
        "output": {
          "type": "object",
          "patternProperties": {
            "^(.*)$": {}
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "source",
              "excerpt"
            ],
            "properties": {
              "source": {
                "minLength": 1,
                "type": "string"
              },
              "datasetId": {
                "minLength": 1,
                "maxLength": 160,
                "type": "string"
              },
              "documentId": {
                "minLength": 1,
                "maxLength": 160,
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "excerpt": {
                "type": "string"
              },
              "similarity": {
                "minimum": 0,
                "maximum": 1,
                "type": "number"
              }
            }
          }
        },
        "risks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "sha256": {
                "pattern": "^[a-f0-9]{64}$",
                "type": "string"
              }
            }
          }
        }
      }
    },
    {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "protocolVersion",
        "taskId",
        "taskNodeId",
        "instanceId",
        "status",
        "summary",
        "interaction",
        "checkpoint"
      ],
      "properties": {
        "protocolVersion": {
          "const": "v1",
          "type": "string"
        },
        "taskId": {
          "minLength": 1,
          "maxLength": 160,
          "type": "string"
        },
        "taskNodeId": {
          "minLength": 1,
          "maxLength": 160,
          "type": "string"
        },
        "instanceId": {
          "minLength": 1,
          "maxLength": 160,
          "type": "string"
        },
        "status": {
          "const": "needs_user_input",
          "type": "string"
        },
        "summary": {
          "minLength": 1,
          "maxLength": 4000,
          "type": "string"
        },
        "interaction": {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "kind",
            "title",
            "prompt",
            "responseSchema",
            "responseTarget"
          ],
          "properties": {
            "kind": {
              "anyOf": [
                {
                  "const": "confirmation",
                  "type": "string"
                },
                {
                  "const": "clarification",
                  "type": "string"
                },
                {
                  "const": "form",
                  "type": "string"
                }
              ]
            },
            "title": {
              "minLength": 1,
              "maxLength": 200,
              "type": "string"
            },
            "prompt": {
              "minLength": 1,
              "maxLength": 4000,
              "type": "string"
            },
            "responseSchema": {
              "additionalProperties": false,
              "type": "object",
              "required": [
                "type",
                "properties",
                "additionalProperties"
              ],
              "properties": {
                "type": {
                  "const": "object",
                  "type": "string"
                },
                "properties": {
                  "minProperties": 1,
                  "maxProperties": 30,
                  "type": "object",
                  "patternProperties": {
                    "^(.*)$": {
                      "additionalProperties": false,
                      "type": "object",
                      "required": [
                        "type"
                      ],
                      "properties": {
                        "type": {
                          "anyOf": [
                            {
                              "anyOf": [
                                {
                                  "const": "string",
                                  "type": "string"
                                },
                                {
                                  "const": "number",
                                  "type": "string"
                                },
                                {
                                  "const": "boolean",
                                  "type": "string"
                                }
                              ]
                            },
                            {
                              "const": "array",
                              "type": "string"
                            }
                          ]
                        },
                        "enum": {
                          "minItems": 1,
                          "maxItems": 50,
                          "uniqueItems": true,
                          "type": "array",
                          "items": {
                            "anyOf": [
                              {
                                "type": "string"
                              },
                              {
                                "type": "number"
                              },
                              {
                                "type": "boolean"
                              }
                            ]
                          }
                        },
                        "minLength": {
                          "minimum": 0,
                          "maximum": 4000,
                          "type": "integer"
                        },
                        "maxLength": {
                          "minimum": 1,
                          "maximum": 4000,
                          "type": "integer"
                        },
                        "minimum": {
                          "type": "number"
                        },
                        "maximum": {
                          "type": "number"
                        },
                        "minItems": {
                          "minimum": 0,
                          "maximum": 50,
                          "type": "integer"
                        },
                        "maxItems": {
                          "minimum": 1,
                          "maximum": 50,
                          "type": "integer"
                        },
                        "items": {
                          "additionalProperties": false,
                          "type": "object",
                          "required": [
                            "type"
                          ],
                          "properties": {
                            "type": {
                              "anyOf": [
                                {
                                  "const": "string",
                                  "type": "string"
                                },
                                {
                                  "const": "number",
                                  "type": "string"
                                },
                                {
                                  "const": "boolean",
                                  "type": "string"
                                }
                              ]
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "required": {
                  "uniqueItems": true,
                  "maxItems": 30,
                  "type": "array",
                  "items": {
                    "minLength": 1,
                    "maxLength": 160,
                    "type": "string"
                  }
                },
                "additionalProperties": {
                  "const": false,
                  "type": "boolean"
                }
              }
            },
            "responseTarget": {
              "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,159}$",
              "type": "string"
            }
          }
        },
        "checkpoint": {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "schemaVersion",
            "resumeKey",
            "workspaceRelativePath",
            "sha256"
          ],
          "properties": {
            "schemaVersion": {
              "const": 1,
              "type": "number"
            },
            "resumeKey": {
              "minLength": 1,
              "maxLength": 160,
              "type": "string"
            },
            "workspaceRelativePath": {
              "minLength": 1,
              "maxLength": 2000,
              "type": "string"
            },
            "sha256": {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            }
          }
        }
      }
    }
  ]
}
