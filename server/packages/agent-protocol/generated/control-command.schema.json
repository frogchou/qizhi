{
  "additionalProperties": false,
  "type": "object",
  "required": [
    "protocolVersion",
    "commandId",
    "type",
    "instanceId"
  ],
  "properties": {
    "protocolVersion": {
      "const": "v1",
      "type": "string"
    },
    "commandId": {
      "minLength": 1,
      "maxLength": 160,
      "type": "string"
    },
    "type": {
      "anyOf": [
        {
          "const": "launch",
          "type": "string"
        },
        {
          "const": "stop",
          "type": "string"
        },
        {
          "const": "recover",
          "type": "string"
        }
      ]
    },
    "instanceId": {
      "minLength": 1,
      "maxLength": 160,
      "type": "string"
    },
    "leaseToken": {
      "minLength": 24,
      "type": "string"
    },
    "envelope": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "protocolVersion",
        "taskId",
        "taskNodeId",
        "instanceId",
        "attemptNumber",
        "leaseToken",
        "workspacePath",
        "input",
        "callback"
      ],
      "properties": {
        "protocolVersion": {
          "const": "v1",
          "type": "string"
        },
        "taskId": {
          "minLength": 1,
          "maxLength": 160,
          "type": "string"
        },
        "taskNodeId": {
          "minLength": 1,
          "maxLength": 160,
          "type": "string"
        },
        "instanceId": {
          "minLength": 1,
          "maxLength": 160,
          "type": "string"
        },
        "attemptNumber": {
          "minimum": 1,
          "type": "integer"
        },
        "leaseToken": {
          "minLength": 24,
          "type": "string"
        },
        "workspacePath": {
          "minLength": 1,
          "type": "string"
        },
        "taskRoot": {
          "minLength": 1,
          "type": "string"
        },
        "nodeWorkspacePath": {
          "minLength": 1,
          "type": "string"
        },
        "sharingGroup": {
          "minLength": 1,
          "maxLength": 160,
          "type": "string"
        },
        "input": {
          "type": "object",
          "patternProperties": {
            "^(.*)$": {}
          }
        },
        "taskInputs": {
          "type": "array",
          "items": {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "id",
              "displayName",
              "sourceType",
              "mediaType",
              "sizeBytes",
              "sha256",
              "path"
            ],
            "properties": {
              "id": {
                "minLength": 1,
                "maxLength": 160,
                "type": "string"
              },
              "displayName": {
                "minLength": 1,
                "maxLength": 255,
                "type": "string"
              },
              "sourceType": {
                "minLength": 1,
                "maxLength": 160,
                "type": "string"
              },
              "mediaType": {
                "minLength": 1,
                "maxLength": 255,
                "type": "string"
              },
              "sizeBytes": {
                "minimum": 1,
                "type": "integer"
              },
              "sha256": {
                "pattern": "^[a-f0-9]{64}$",
                "type": "string"
              },
              "path": {
                "minLength": 1,
                "maxLength": 2000,
                "type": "string"
              }
            }
          }
        },
        "callback": {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "url"
          ],
          "properties": {
            "url": {
              "minLength": 1,
              "maxLength": 2000,
              "type": "string"
            }
          }
        },
        "resultCallback": {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "url"
          ],
          "properties": {
            "url": {
              "minLength": 1,
              "maxLength": 2000,
              "type": "string"
            }
          }
        },
        "deadlineAt": {
          "minLength": 20,
          "maxLength": 64,
          "type": "string"
        },
        "checkpointRef": {
          "minLength": 1,
          "maxLength": 160,
          "type": "string"
        },
        "resume": {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "fromInteractionId",
            "checkpoint",
            "answers"
          ],
          "properties": {
            "fromInteractionId": {
              "minLength": 1,
              "maxLength": 160,
              "type": "string"
            },
            "checkpoint": {
              "additionalProperties": false,
              "type": "object",
              "required": [
                "schemaVersion",
                "resumeKey",
                "workspaceRelativePath",
                "sha256"
              ],
              "properties": {
                "schemaVersion": {
                  "const": 1,
                  "type": "number"
                },
                "resumeKey": {
                  "minLength": 1,
                  "maxLength": 160,
                  "type": "string"
                },
                "workspaceRelativePath": {
                  "minLength": 1,
                  "maxLength": 2000,
                  "type": "string"
                },
                "sha256": {
                  "pattern": "^[a-f0-9]{64}$",
                  "type": "string"
                }
              }
            },
            "answers": {
              "maxItems": 50,
              "type": "array",
              "items": {
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "interactionId",
                  "response"
                ],
                "properties": {
                  "interactionId": {
                    "minLength": 1,
                    "maxLength": 160,
                    "type": "string"
                  },
                  "response": {
                    "type": "object",
                    "patternProperties": {
                      "^(.*)$": {}
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
