{
  "additionalProperties": false,
  "type": "object",
  "required": [
    "protocolVersion",
    "taskId",
    "taskNodeId",
    "instanceId",
    "leaseToken",
    "sequence",
    "type",
    "payload"
  ],
  "properties": {
    "protocolVersion": {
      "const": "v1",
      "type": "string"
    },
    "taskId": {
      "minLength": 1,
      "maxLength": 160,
      "type": "string"
    },
    "taskNodeId": {
      "minLength": 1,
      "maxLength": 160,
      "type": "string"
    },
    "instanceId": {
      "minLength": 1,
      "maxLength": 160,
      "type": "string"
    },
    "leaseToken": {
      "minLength": 24,
      "type": "string"
    },
    "sequence": {
      "minimum": 1,
      "type": "integer"
    },
    "type": {
      "anyOf": [
        {
          "const": "started",
          "type": "string"
        },
        {
          "const": "progress",
          "type": "string"
        },
        {
          "const": "checkpoint",
          "type": "string"
        },
        {
          "const": "completed",
          "type": "string"
        },
        {
          "const": "failed",
          "type": "string"
        },
        {
          "const": "heartbeat",
          "type": "string"
        },
        {
          "const": "output",
          "type": "string"
        }
      ]
    },
    "payload": {
      "type": "object",
      "patternProperties": {
        "^(.*)$": {}
      }
    }
  }
}
