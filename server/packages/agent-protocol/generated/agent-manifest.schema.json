{
  "additionalProperties": false,
  "type": "object",
  "required": [
    "protocolVersion",
    "agentId",
    "displayName",
    "version",
    "capabilities"
  ],
  "properties": {
    "protocolVersion": {
      "const": "v1",
      "type": "string"
    },
    "agentId": {
      "minLength": 1,
      "maxLength": 160,
      "type": "string"
    },
    "displayName": {
      "minLength": 1,
      "maxLength": 200,
      "type": "string"
    },
    "version": {
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+][0-9A-Za-z.-]+)?$",
      "type": "string"
    },
    "capabilities": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "minLength": 1,
            "maxLength": 160,
            "type": "string"
          },
          "description": {
            "maxLength": 2000,
            "type": "string"
          }
        }
      }
    },
    "runtime": {
      "anyOf": [
        {
          "const": "codex",
          "type": "string"
        },
        {
          "const": "pi",
          "type": "string"
        },
        {
          "const": "native",
          "type": "string"
        }
      ]
    },
    "entryCommand": {
      "minItems": 1,
      "type": "array",
      "items": {
        "minLength": 1,
        "maxLength": 500,
        "type": "string"
      }
    },
    "selfCheckCommand": {
      "minLength": 1,
      "maxLength": 500,
      "type": "string"
    }
  }
}
