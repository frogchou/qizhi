{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["query"],
  "properties": {
    "query": { "type": "string", "minLength": 1 },
    "maxResults": { "type": "integer", "minimum": 1, "maximum": 10, "default": 5 },
    "language": { "type": "string", "default": "zh-CN" }
  },
  "additionalProperties": false
}
