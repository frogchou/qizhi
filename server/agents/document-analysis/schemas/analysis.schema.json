{
  "type": "object",
  "required": ["overview", "documents"],
  "properties": {
    "overview": { "type": "string", "minLength": 1, "maxLength": 12000 },
    "documents": {
      "type": "array", "minItems": 1, "maxItems": 30,
      "items": {
        "type": "object",
        "required": ["documentId", "purpose", "summary", "keyPoints", "evidence", "limitations"],
        "properties": {
          "documentId": { "type": "string", "minLength": 1, "maxLength": 160 },
          "purpose": { "type": "string", "minLength": 1, "maxLength": 12000 },
          "summary": { "type": "string", "minLength": 1, "maxLength": 24000 },
          "keyPoints": { "type": "array", "maxItems": 20, "items": { "type": "string", "minLength": 1, "maxLength": 4000 } },
          "evidence": { "type": "array", "minItems": 1, "maxItems": 12, "items": { "type": "string", "minLength": 1, "maxLength": 1200 } },
          "limitations": { "type": "array", "maxItems": 20, "items": { "type": "string", "minLength": 1, "maxLength": 2000 } }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
