{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["requirements", "targets"],
  "properties": {
    "requirements": { "type": "string", "minLength": 1 },
    "targets": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "targetType": { "type": "string", "enum": ["document", "code", "mixed"], "default": "mixed" },
    "acceptanceLevel": { "type": "string", "enum": ["strict", "standard"], "default": "standard" }
  },
  "additionalProperties": false
}
